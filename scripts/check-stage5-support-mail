#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

support_query='in:anywhere newer_than:3d (from:support@twilio.zendesk.com OR from:trusthub-verify@twilio.zendesk.com OR from:trusthub-verify@twilio.com OR from:donotreply@twilio.com OR from:sellside-support-team@google.com OR from:adsense-noreply@google.com OR 29130096 OR 29130973 OR 29220979 OR 00443858 OR 30038)'

if [[ "${1:-}" == "--query" ]]; then
  if [[ -z "${2:-}" || $# -ne 2 ]]; then
    echo "usage: $0 [--query <gmail-search-query>]" >&2
    exit 64
  fi
  support_query="$2"
elif [[ $# -ne 0 ]]; then
  echo "usage: $0 [--query <gmail-search-query>]" >&2
  exit 64
fi

"${script_dir}/stage5-gmail" gmail +triage \
  --query "${support_query}" \
  --max 100 \
  --format json \
  | jq -e -f "${script_dir}/stage5-gmail-triage.jq"
