{
  "name": "stage5.tools",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "audit:indexing": "node scripts/audit-indexing-policy.mjs",
    "audit:locales": "node scripts/audit-shared-locales.mjs",
    "audit:rendered": "node scripts/audit-rendered-seo.mjs",
    "build": "npm run audit:locales && next build --webpack && npm run audit:indexing",
    "test:analytics": "node --experimental-strip-types --test test/analytics-events.test.mjs test/third-party-script-bootstrap.test.mjs test/analytics-consent.test.mjs test/device-detection.test.mjs",
    "test:watch": "node --test test/watch-catalog-validation.test.mjs test/watch-runtime-catalog.test.mjs",
    "test:seo": "node --experimental-strip-types --test test/json-ld.test.mjs test/site-routing.test.mjs",
    "test": "npm run test:analytics && npm run test:watch && npm run test:seo && npm run test:reflect && npm run test:http",
    "test:http": "node --test test/http-robustness.test.mjs",
    "fallback:build": "esbuild pages-fallback/worker.mjs --bundle --format=esm --platform=browser --outfile=.local/pages-fallback-dist/_worker.js && cp pages-fallback/_routes.json .local/pages-fallback-dist/_routes.json",
    "start": "next start",
    "lint": "eslint app components hooks lib middleware.ts next.config.ts",
    "workers:build": "opennextjs-cloudflare build --config wrangler.worker.toml",
    "workers:preview": "opennextjs-cloudflare preview --config wrangler.worker.toml",
    "pages": "node -e \"console.error('The legacy Pages adapter cannot build the security-patched site. Use npm run workers:build; production migration requires approval.'); process.exit(1)\"",
    "monitor:dev": "wrangler dev -c monitor/wrangler.toml",
    "monitor:deploy": "wrangler deploy -c monitor/wrangler.toml",
    "monitor:test": "node --test monitor/test/monitor.test.mjs",
    "monitor:demo:pass": "node monitor/scripts/demo-run.mjs pass",
    "monitor:demo:force": "node monitor/scripts/demo-run.mjs force",
    "watch:seed": "node scripts/seed-watch-catalog.mjs",
    "watch:publish": "node scripts/publish-watch.mjs",
    "watch:audit-cache": "node scripts/refresh-watch-cache-metadata.mjs",
    "watch:audit-edge-cache": "node scripts/audit-watch-edge-cache.mjs",
    "test:reflect": "node --test test/reflect-session.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.513.0",
    "next": "16.4.3",
    "react": "19.1.9",
    "react-dom": "19.1.9"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.709.0",
    "@opennextjs/cloudflare": "1.20.13",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.25.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.125.0"
  },
  "overrides": {
    "js-yaml": "^4.3.0",
    "minimatch@3": {
      "brace-expansion": "^1.1.16"
    },
    "minimatch@9": {
      "brace-expansion": "^2.1.2"
    },
    "tar": "^7.5.21",
    "postcss": "^8.5.28",
    "nanoid@3": "^3.3.18",
    "sharp": "^0.35.4"
  }
}
